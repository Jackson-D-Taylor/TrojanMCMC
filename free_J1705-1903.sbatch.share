#!/bin/bash

#SBATCH --job-name=J1705-1903_free
#SBATCH --output=J1705-1903_free.out
#SBATCH -e J1705-1903_free.err
#
#SBATCH --partition=comm_small_week
#SBATCH --ntasks=16
#SBATCH --time=7-00:00:00


date
echo Running on host: $(hostname)
echo Job ID: $SLURM_JOB_ID
module load parallel/openmpi/5.0.2_gcc122
module load lang/gcc/12.2.0
module load libs/openblas/0.3.26_gcc122
source ~/.bashrc
micromamba activate trojans


which python3

mpirun -np 16 python3 search_troj.py -pname J1705-1903 -mc_min 0.04035623678130271369 -niter 5000000 --free_theta

echo all done
date